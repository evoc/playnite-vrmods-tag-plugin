<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Roslyn analyzers are off by default on a net462 target (the SDK turns
         them on for net5+ only), so none of the framework's own rules ever ran
         on a codebase that parses twelve attacker-chosen websites and writes
         into the Playnite library. The posture is "every family on, unless a
         family has been judged and excluded with a written reason":
         AnalysisMode=All enables all of them, and .editorconfig carries the
         exclusions, each with why. That inversion matters - a rule nobody sees
         is the same as no rule. Every exclusion and its reason lives in
         .editorconfig, where the build enforces it. Adding a new exclusion needs
         a reason at the exclusion site. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

 <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

 <ItemGroup>
    <None Include="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="extension.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Shipped next to the DLL so the installed extension's Help button opens the
         README that matches the installed version (Playnite extracts every file
         in the .pext into the extension directory). -->
    <None Include="..\README.md" Link="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The user manual (docs/README.md landing page + sub-pages + img/ figures),
         resolved by VrModHelp relative to the loaded assembly. -->
    <None Include="..\docs\**" LinkBase="docs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Version comes from the git tag (see GitVersion.yml); the tag is created
         automatically by the release workflow on every push to main. -->
    <PackageReference Include="GitVersion.MsBuild" Version="6.8.2" PrivateAssets="all" />
    <!-- The net462 reference assemblies the committed packages.lock.json
         already records as a Direct dependency at 1.0.3: a machine without
         the old .NET Framework targeting pack gets this package injected
         by the SDK, a machine with the pack installed does not - and a
         locked-mode restore then judges the project against a lock file
         written on the other kind of machine. That is how the first
         release run with lock files failed on windows-latest with NU1004
         while the same build passed locally. Naming it here makes the
         graph identical on both. PrivateAssets=all: reference assemblies
         only, nothing of it ends up in the shipped .pext. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies"
                      Version="1.0.3" PrivateAssets="all" />
     <PackageReference Include="PlayniteSDK" Version="6.18.0" />
     <PackageReference Include="System.Text.Json" Version="8.0.5" />
     <PackageReference Include="System.ValueTuple" Version="4.5.0" />
   </ItemGroup>

  </Project>
