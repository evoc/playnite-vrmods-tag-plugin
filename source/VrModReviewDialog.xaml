<Window x:Class="Playnite.VRMods.VrModReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Playnite.VRMods"
        Title="VRMod: Review Matches"
        Width="1240" Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="OnPreviewKeyDown"
        Style="{DynamicResource VrWindowStyle}">
    <!--
        VRMod review dialog.

        Themed from Playnite's active theme (DynamicResource keys merged into
        Application.Resources by Playnite at startup). The DataGrid inherits Playnite's
        themed implicit DataGrid style; no control templates are redefined here.

        Column headers are plain strings in this file only as a pre-load fallback; the
        code-behind (ApplyColumnHeaders) replaces every header with a themed element that
        carries the column's tooltip and, after a sort click, its sort arrow. Playnite's
        themed DataGridColumnHeader template has no built-in sort arrow, so the arrow is
        part of the header content (shown only on the column the user sorted, never in
        the default order).

        RowHeaderWidth=0 removes the DataGrid's row-header strip (the narrow empty first
        column left over from the old checkbox design).

        NOTE: The Status column is text-only. It shows the combined decision + saved state
        (Saved / New / Rejected / Rejected (new) / Pending), colored by the decision and
        italic when not yet saved. Double-click a row to cycle its status
        Pending -> Accepted -> Rejected.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <local:MatchDecisionToBrushConverter x:Key="MatchDecisionToBrush"/>

            <!-- Secondary/muted text: theme font (small) + dimmed text color. -->
            <Style x:Key="VrTextMuted" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <!--
                Playnite window chrome (cloned from Playnite's StandardWindowStyle, which is
                TargetType=WindowBase and therefore not applicable to a plain Window). The
                plugin cannot reference Playnite's app assembly (it is not part of the SDK),
                so the chrome is cloned here with TargetType=Window. Every brush, font, and
                the WindowBarButton style are Playnite theme resources resolved at runtime,
                so the window follows the active theme (light/dark) exactly like the
                settings window and every other Playnite dialog:
                  - WindowBackgourndBrush: window background (Playnite's own key, typo and
                    all)
                  - PopupBorderBrush: 1px window border
                  - BaseTextBlockStyle: title text
                  - WindowBarButton: the Marlett-glyph minimize/maximize/close buttons
                    (glyphs 0 / 1|2 / r), hover foreground from the theme
                -->
            <Style x:Key="VrWindowStyle" TargetType="Window">
                <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
                <Setter Property="WindowChrome.WindowChrome">
                    <Setter.Value>
                        <WindowChrome CaptionHeight="25" CornerRadius="0" ResizeBorderThickness="4"
                                      NonClientFrameEdges="None" UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Window}">
                            <AdornerDecorator>
                                <Border x:Name="WindowBorder" BorderBrush="{DynamicResource PopupBorderBrush}" CornerRadius="0"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Background="{TemplateBinding Background}">
                                    <Grid>
                                        <ContentPresenter Margin="0,25,0,0"/>
                                        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                                            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                                                <TextBlock Text="{TemplateBinding Title}" DockPanel.Dock="Left" Margin="10,3,0,0" VerticalAlignment="Center"
                                                           Opacity="0.75" Style="{DynamicResource BaseTextBlockStyle}" x:Name="PART_TextTitle" />
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,3,5,0">
                                                    <Button Style="{DynamicResource WindowBarButton}" Content="0" x:Name="PART_ButtonMinimize" Click="MinimizeButton_Click"/>
                                                    <Button Style="{DynamicResource WindowBarButton}" Content="1" x:Name="PART_ButtonMaximize" Click="MaximizeButton_Click"/>
                                                    <Button Style="{DynamicResource WindowBarButton}" Content="r" x:Name="PART_ButtonClose" Click="CloseButton_Click"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </AdornerDecorator>
                            <ControlTemplate.Triggers>
                                <Trigger Property="WindowState" Value="Maximized">
                                    <Setter Property="Content" Value="2" TargetName="PART_ButtonMaximize"/>
                                    <Setter Property="Padding" Value="8" TargetName="WindowBorder"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Footer. The destructive "Reset all decisions" sits on the far left, separated
             from the primary actions (right-aligned) so it is not confused with Save/Cancel.
             Save is the primary action. IsEnabled is toggled off while "Reset and remove
             tags" runs (in the background) so Save/Cancel/Reset can't race the removal. -->
        <DockPanel x:Name="FooterPanel" DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <!-- Destructive global action: clears every stored decision so all matches are
                 presented for review again on the next scan. Confirmed by the handler. -->
            <Button DockPanel.Dock="Left" Content="Reset all decisions"
                    ToolTip="Clear every stored decision so all matches are reviewed again."
                    Click="ResetAllDecisions_Click" Padding="12,4" />
            <!-- Bulk actions operate on the data (each row's Status), not on the controls:
                 the selection when the user has selected one or more rows, otherwise every
                 match. The labels are updated in the SelectionChanged handler. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AcceptButton" Content="Accept All" Click="AcceptButton_Click"
                        ToolTip="Accept the selected rows (or every match if none are selected). Alt+A"
                        Margin="0,0,8,0" Padding="12,4" />
                <Button x:Name="RejectButton" Content="Reject All" Click="RejectButton_Click"
                        ToolTip="Reject the selected rows (or every match if none are selected). Alt+R"
                        Margin="0,0,8,0" Padding="12,4" />
                <Button Content="Save" Click="Save_Click" ToolTip="Save (Ctrl+S)"
                        Margin="0,0,8,0" Padding="16,4" Background="{DynamicResource NormalBrush}" />
                <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Padding="12,4" />
            </StackPanel>
        </DockPanel>

        <!-- Filter row: text filter (with clear button), time window, changed-only toggle,
             Columns… (show/hide), and Help (non-modal popup with the how-to text). -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filter:" Style="{StaticResource VrTextMuted}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Grid Width="300"
                      ToolTip="Hide rows. The text is matched (case-insensitive) against any column: source, source entry, game, tags, status, saved at.">
                    <TextBox x:Name="FilterBox" Padding="4,2,24,2"
                             VerticalContentAlignment="Center"
                             TextChanged="FilterBox_TextChanged"/>
                    <!-- Clear button (Playnite main-filter style): inside the box, right-aligned,
                         collapsed until the box has text; clears the filter on click. -->
                    <Button x:Name="FilterClearButton" Content="&#x2299;"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Padding="2,0" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextBrushDarker}" FontSize="16"
                            Visibility="Collapsed" ToolTip="Clear filter"
                            Click="FilterClearButton_Click"/>
                </Grid>
                <TextBlock Text="Time:" Style="{StaticResource VrTextMuted}"
                           VerticalAlignment="Center" Margin="16,0,8,0"/>
                <ComboBox x:Name="TimeFilter" Width="120" VerticalAlignment="Center"
                          VerticalContentAlignment="Center"
                          ToolTip="Only show matches whose decision was saved within this time window. Alt+T"
                          SelectionChanged="TimeFilter_SelectionChanged">
                    <ComboBoxItem Content="All times" Tag="-1" IsSelected="True"/>
                    <ComboBoxItem Content="Last hour" Tag="3600"/>
                    <ComboBoxItem Content="Last day" Tag="86400"/>
                    <ComboBoxItem Content="Last week" Tag="604800"/>
                    <ComboBoxItem Content="Last month" Tag="2592000"/>
                </ComboBox>
                <!-- Changed only: show just the rows whose tags changed since the last accept.
                     A discrete toggle (no debounce, unlike the keystroke filter). -->
                <CheckBox x:Name="ChangedOnlyCheckBox" Content="Changed only"
                          VerticalAlignment="Center" Margin="16,0,0,0"
                          ToolTip="Only show rows whose tags changed since the last accept."
                          Checked="ChangedOnly_Changed" Unchecked="ChangedOnly_Changed"/>
                <Button x:Name="StatusButton" Content="Status: all" Click="StatusButton_Click"
                        Margin="16,0,0,0" VerticalAlignment="Center" Padding="12,4"
                        ToolTip="Filter rows by status (Pending / Accepted / Rejected). Tick a status to include it; &quot;Pending only&quot; for a quick single-status view. Alt+S"/>
                <Button x:Name="ColumnsButton" Content="Columns&#8230;" Click="ColumnsButton_Click"
                        Margin="16,0,0,0" VerticalAlignment="Center" Padding="12,4"
                        ToolTip="Show or hide columns. Alt+C"/>
                <Button x:Name="HelpButton" Content="Help" Click="HelpButton_Click"
                        Margin="8,0,0,0" VerticalAlignment="Center" Padding="12,4"
                        ToolTip="How to use this dialog. Alt+H"/>
                <!-- Help: non-modal popup with the how-to text (the popup closes when it loses
                     focus and together with the window). -->
                <Popup x:Name="HelpPopup"
                       PlacementTarget="{Binding ElementName=HelpButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource PopupBackgroundBrush}"
                            BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="10" Width="520" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource VrTextMuted}" LineHeight="18" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold">Exact matches</Run> (score 1.00) are accepted by default; fuzzy matches start as "Pending".
                            <LineBreak/>
                            <Run FontWeight="SemiBold">Suggested</Run> is a candidate game the matching rules found but refuse to call a match — hover the status cell to see why (which words agree, which are left over). Accept it to make the pairing stick; every later scan then matches that listing to that game whatever either is called.
                            <LineBreak/>
                            <Run FontWeight="SemiBold">Status</Run>: "Saved" / "New" (accepted), "Rejected" / "Rejected (new)", or "Pending". Italic means it is not yet saved to the library.
                            <LineBreak/>
                            <Run FontWeight="SemiBold">Double-click a row</Run> to cycle its status Pending &#8594; Accepted &#8594; Rejected.
                            <LineBreak/>
                            <Run FontWeight="SemiBold">Saved at</Run> shows when the current decision was saved (the time filter works on this).
                            <LineBreak/>
                            <Run FontWeight="SemiBold">Status</Run> (the "Status…" button) filters rows by status: tick a status to include it (multi-select); "Pending only" for a quick single-status view.
                            <LineBreak/>
                            <Run FontWeight="SemiBold">Select rows</Run> to scope Accept/Reject to just those; with no selection the buttons act on all matches.
                            <LineBreak/>
                            <Run FontWeight="SemiBold">Right-click a row</Run> for a quick Accept / Reject / Set to Pending menu.
                            <LineBreak/>
                            <Run FontWeight="SemiBold">Keyboard</Run>: Alt+F focuses the filter, Alt+T opens the time window, Alt+S the status menu, Alt+C the columns menu, Alt+H this help, and Alt+A / Alt+R accept / reject directly (the selection, or every match). With the list focused, Enter accepts, R rejects, and P sets the row to Pending. Ctrl+S saves.
                            <LineBreak/>
                            <Run FontWeight="SemiBold">Reset all decisions</Run> (bottom-left) clears every decision so all matches are reviewed again.
                        </TextBlock>
                    </Border>
                </Popup>
            </StackPanel>
        </Border>

        <!-- Matches grid (themed via Playnite's implicit DataGrid style). Headers are
             sortable (CanUserSortColumns=True) and the code-behind rebuilds the multi-level
             sort on each header click, so the secondary tiebreakers (Playnite game name,
             then source name) are always kept. Text columns are read-only display cells. -->
        <Grid>
            <DataGrid x:Name="MatchesDataGrid"
                      ItemsSource="{Binding}"
                      KeyDown="MatchesDataGrid_KeyDown"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      CanUserReorderColumns="True"
                      SelectionMode="Extended"
                      RowHeaderWidth="0">
                <!-- Right-click a row for a quick per-row (or per-selection) decision. The menu
                     items act on the same targets as the bulk buttons: the selection when one or
                     more rows are selected, otherwise every match. Right-clicking a row selects it
                     first (see OnGridPreviewMouseRightButtonUp), so a single right-click scopes to
                     that row. -->
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Accept" Click="AcceptMenuItem_Click"/>
                        <MenuItem Header="Reject" Click="RejectMenuItem_Click"/>
                        <MenuItem Header="Set to Pending" Click="PendingMenuItem_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <!-- Status column: text-only (the checkbox column was removed). Shows the
                         combined decision + saved state (Saved / New / Rejected / Rejected (new) /
                         Pending / Suggested), colored by the decision (gray/green/red) and italic when
                         the decision is not yet saved to JSON. Double-click the row to cycle
                         Pending -> Accepted -> Rejected. A Suggested row's status cell carries the
                         pairing's reason as its tooltip — see VrModReviewMatchEntry.ReasonTooltip —
                         because that row exists precisely to be read. -->
                    <DataGridTemplateColumn x:Name="StatusColumn" Header="Status" Width="90" SortMemberPath="StatusSortRank">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayStatusText}"
                                           Foreground="{Binding Status, Converter={StaticResource MatchDecisionToBrush}}"
                                           Background="Transparent"
                                           ToolTip="{Binding ReasonTooltip}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUnsaved}" Value="True">
                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="SourceColumn" Header="Source" Binding="{Binding SourceName}" SortMemberPath="SourceName" IsReadOnly="True" Width="150"/>
                    <DataGridTextColumn x:Name="SourceEntryColumn" Header="Source Entry" Binding="{Binding SourceGameName}" SortMemberPath="SourceGameName" IsReadOnly="True" Width="200"/>
                    <DataGridTextColumn x:Name="GameColumn" Header="Game" Binding="{Binding GameDisplayName}" SortMemberPath="GameDisplayName" IsReadOnly="True" Width="220"/>
                    <DataGridTextColumn x:Name="ScoreColumn" Header="Score" Binding="{Binding Score, StringFormat={}{0:F2}}" SortMemberPath="Score" IsReadOnly="True" Width="60"/>
                    <!-- Saved at: when the current decision was last saved to JSON ("—" when none).
                         Hidden by default (Columns… menu shows it unchecked): it only carries data
                         for already-decided matches, which the notification/pending-only flow
                         does not show. -->
                    <DataGridTextColumn x:Name="SavedAtColumn" Header="Saved at" Binding="{Binding SavedAtDisplay}" SortMemberPath="SavedAtDisplay" IsReadOnly="True" Width="130" Visibility="Collapsed"/>
                    <!-- Tags: the tags that would be applied (category + facets). Italic with a
                         trailing "&#x2191;" marker when this accepted match's source tags changed since
                         the last accept (the "Changed" column and the cell tooltip show the detail).
                         A template column (not a text column) so the italic DataTrigger + tooltip can
                         be applied; still sorts on TagPreview (the actual preview, not the marker). -->
                    <DataGridTemplateColumn x:Name="TagsColumn" Header="Tags" Width="*" SortMemberPath="TagPreview">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TagPreviewWithMarker}" Background="Transparent"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding TagPreviewWithMarker}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <!-- The cell clips (a five-tag preview measured 864 px inside
                                                     a 495 px column at 150 % DPI), so the tooltip is what makes
                                                     the cut text reachable: the full preview by default, and the
                                                     delta - which is the more useful reading - once the tags
                                                     have changed since this match was accepted. -->
                                                <DataTrigger Binding="{Binding TagsChanged}" Value="True">
                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                    <Setter Property="ToolTip" Value="{Binding TagDeltaTooltip}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- Changed: the tag delta since the last accept (e.g. "+ VRMod 6DOF"); empty when
                         unchanged. Sortable by TagsChanged — clicking the header puts the changed rows
                         on top so you can see what the source changed for your accepted matches. -->
                    <DataGridTextColumn x:Name="ChangedColumn" Header="Changed" Binding="{Binding TagDeltaText}" SortMemberPath="TagsChanged" IsReadOnly="True" Width="100"/>
                    <!-- Open the exact mod/game page for the row on its source: a per-game deep link when
                         the source provides one (e.g. PCVR Central), otherwise the source's website. It is
                         the last, narrowest, non-sortable column so it sits at the far right without
                         disturbing the sortable text columns; the button's DataContext is the row item.
                         Its header is a link symbol only; the Columns… menu names it "Link to Mod". -->
                    <DataGridTemplateColumn x:Name="LinkColumn" Header="" Width="45" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="&#x2197;" ToolTip="Open mod page"
                                        Click="OpenModPage_Click" Padding="4,0"
                                        HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty-state hint: shown over the grid when the active filters (text / time /
                 changed-only) hide every row, so an empty grid is never mistaken for "no data". -->
            <TextBlock x:Name="EmptyHint"
                       Text="No matches for the current filters."
                       FontFamily="{DynamicResource FontFamily}"
                       FontSize="{DynamicResource FontSize}"
                       Foreground="{DynamicResource TextBrushDarker}"
                       FontStyle="Italic"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
